  "sport": "soccer",
  "title": "Pass through the gates",
  "description": "Play 6 v 6 in about 50 × 40 metres with nine cone gates, about 3 metres wide, spread over the area. A team scores by passing the ball through any gate to a team-mate on the other side. After a goal the team must find a new gate – the same gate twice in a row does not count.\n\nVariant: 1–2 jokers who play with the team in possession. The diagram shows fewer players and gates and is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Check before the ball arrives – where are your team-mates, and which gates are free?"
    },
    {
      "id": "cp2",
      "text": "Move out of the passing shadow so the player on the ball can reach you."
    },
    {
      "id": "cp3",
      "text": "Offer different distances: someone close, someone further away."
    },
    {
      "id": "cp4",
      "text": "After a goal – look straight away for the next free gate."
    }
  ],
  "locale": "en",
  "phase": "game",
  "difficulty": 2,
