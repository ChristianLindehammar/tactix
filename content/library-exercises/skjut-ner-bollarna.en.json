  "sport": "soccer",
  "title": "Knock the balls off",
  "description": "Two teams stand on a line each, about 15–20 metres apart and facing each other. Halfway between them is a row of cones with a ball on top of each one. The blue team have a ball each and try to knock the balls off the cones.\n\nThe red team stop the balls that come through, the knocked-off balls go back on the cones, and then it is red's turn to shoot. Count how many balls each team knocks off. Bring the lines closer if it is too hard.\n\nTry both the inside of the foot and the laces. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Standing foot beside the ball, toes pointing at the target – that is where the ball goes."
    },
    {
      "id": "cp2",
      "text": "Lean over the ball to keep it down."
    },
    {
      "id": "cp3",
      "text": "Strike the middle of the ball."
    },
    {
      "id": "cp4",
      "text": "Stop the ball before you shoot it back."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "difficulty": 1,
