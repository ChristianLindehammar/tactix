  "sport": "soccer",
  "title": "Turn and shoot",
  "description": "A forward stands with their back to goal at the edge of the penalty area, a defender behind them. A server plays the ball into the forward's feet. The forward feels where the defender is, turns towards the free side and shoots. At first the defender only follows; then they defend for real.\n\nSwap roles after a few goes: server becomes forward, forward becomes defender. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Check over your shoulder before the ball arrives – know where the defender is."
    },
    {
      "id": "cp2",
      "text": "Feel the defender with your arm or back and turn away from where they stand."
    },
    {
      "id": "cp3",
      "text": "The first touch of the turn should take you past them – not just around."
    },
    {
      "id": "cp4",
      "text": "Shoot quickly after the turn, before the defender can recover."
    }
  ],
  "locale": "en",
