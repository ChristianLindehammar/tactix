  "sport": "hockey",
  "title": "Wide V – pass out wide and shoot",
  "description": "Three lines: A along the left side, B along the right side and C in the middle with the pucks. A skates along the side with their stick on the ice. C passes to A level with the cone. A receives and goes for goal. Then B skates along their side and gets a pass from C, and so on.\n\nRotation: A goes to line C, C goes to the side they passed to, and B goes to line C after their shot. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Stick on the ice – show where you want the puck."
    },
    {
      "id": "cp2",
      "text": "C: pass in front of the skater, level with the cone."
    },
    {
      "id": "cp3",
      "text": "Receive on the move and go straight for goal."
    }
  ],
