  "sport": "floorball",
  "title": "Simple handover – shot and rebound",
  "description": "Two lines at the centre line, one by each board. A passes along the centre line to B, who carries the ball diagonally in towards the middle. A runs in at the same time, and B hands the ball over to A, who shoots. B carries on towards goal and picks up any rebound.\n\nSwap lines after each turn, or play the first pass from alternate sides. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Leave the ball dead still at the handover – A takes it at speed."
    },
    {
      "id": "cp2",
      "text": "The receiver should arrive at full speed, not stand and wait."
    },
    {
      "id": "cp3",
      "text": "B: always follow in towards goal – rebounds bring lots of goals."
    }
  ],
  "locale": "en",
  "difficulty": 1,
  "focus": [
