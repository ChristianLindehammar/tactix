  "sport": "floorball",
  "title": "Basketball – only pass to someone who is free",
  "description": "A group of players move freely inside a box, and there are fewer balls than players. Whoever has a ball passes to someone who has no ball and is not about to get one either. That means everyone has to look up before they pass. Play a few minutes at a time.\n\nAllow about ten square metres per player, for example 10 × 10 metres for ten players. Show what space means by letting one group play very tight and another in a big area. If focus drops: count passes that go to someone who already has a ball – lowest score wins. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Look up before you pass – who is free?"
    },
    {
      "id": "cp2",
      "text": "Without the ball: move to where you can get a pass and show yourself."
    },
    {
      "id": "cp3",
      "text": "A pass is a conversation – it needs both a passer and a receiver."
    }
  ],
  "locale": "en",
  "difficulty": 1,
  "focus": [
    "passing"
  ],
  "phase": "warmup",
  "durationMinutes": 8,
  "minPlayers": 6,
