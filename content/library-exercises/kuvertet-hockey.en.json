  "sport": "hockey",
  "title": "The envelope – passing chain and shot",
  "description": "Four spots make an envelope in front of one net, with a player on each spot. Everyone else lines up with all the pucks. The first in line plays a firm pass to the player on the first spot, who passes straight on to the next, and so on until the puck reaches the player in the slot in front of the net, who shoots.\n\nRight after each pass, skate after the puck and take the next spot. The shooter joins the back of the line. The drill uses one zone. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass along the ice to the receiver's blade."
    },
    {
      "id": "cp2",
      "text": "Show with your stick where you want the puck."
    },
    {
      "id": "cp3",
      "text": "Skate to the next spot straight after your pass."
    }
  ],
  "locale": "en",
  "difficulty": 2,
  "focus": [
