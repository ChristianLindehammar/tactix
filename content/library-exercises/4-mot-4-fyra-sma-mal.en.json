  "sport": "soccer",
  "title": "4v4 to four small goals",
  "description": "A 4v4 small-sided game without goalkeepers on an area of about 30 × 20 metres. Each team attacks two small goals on the opponents' end line, one in each corner. When the opponents cover one goal, the team switches play and attacks the other.\n\nPlay short periods of 3–4 minutes with rest in between. Make it harder by only counting goals scored after a switch of play. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Make the pitch big when you have the ball – one player on each side."
    },
    {
      "id": "cp2",
      "text": "See the opponents shifting across? Switch play with one or two quick passes."
    },
    {
      "id": "cp3",
      "text": "Defence: shift together towards the ball side and cover the nearest goal."
    },
    {
      "id": "cp4",
      "text": "When you win the ball: look straight away for the open goal."
    }
  ],
