  "sport": "hockey",
  "title": "Passing in pairs",
  "description": "The players stand in pairs facing each other, one puck per pair. Pass to your partner, who receives the puck and passes back. It takes concentration – every pass should be accurate.\n\nVariations: receive the puck with your skate and kick it up to your stick, receive on the backhand and pass on the forehand (and the other way round), pass straight back first time, or saucer the pass over a stick lying on the ice between you. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass along the ice to your partner's blade."
    },
    {
      "id": "cp2",
      "text": "Show with your stick where you want the puck."
    },
    {
      "id": "cp3",
      "text": "Soft blade when you receive – cushion the puck."
    }
  ],
