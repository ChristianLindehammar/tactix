  "sport": "basketball",
  "title": "Four corners – pass and follow",
  "description": "Four lines in the corners of a square in the half court, about seven metres apart. The first player in one line has the ball. Pass to the next line clockwise and run after the pass to the back of the line you passed to. The receiver catches, turns to the next line and passes on in the same way.\n\nOnce it flows: add a second ball in the line diagonally opposite, so two balls go round at the same time. Change direction after a minute.\n\nVariations: chest pass, bounce pass or overhead pass; meet the ball with a step out of the line; pass it on without stopping. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Meet the ball – take a step towards the pass instead of waiting for it."
    },
    {
      "id": "cp2",
      "text": "Show a clear target hand and call the name of the player you pass to."
    },
    {
      "id": "cp3",
      "text": "Hard, straight passes at chest height; pass and go straight away."
    },
    {
      "id": "cp4",
      "text": "With two balls: keep your head up so you see both."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "difficulty": 1,
  "focus": [
    "passing",
    "ballControl"
  ],
