  "sport": "soccer",
  "title": "Build-up from the goalkeeper, 4+1 v 3",
  "description": "The goalkeeper and four defenders build up from their own goal against three pressing forwards. The defenders score by playing the ball into either of two small goals at the halfway line – or by dribbling it over the halfway line. If the forwards win the ball, they finish on the big goal as quickly as possible.\n\nStart each time from the goalkeeper. Make it harder with more forwards, or by only counting goals after the ball has gone through the goalkeeper once. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Make the pitch wide – full-backs high and close to the touchline."
    },
    {
      "id": "cp2",
      "text": "The centre-backs split so the goalkeeper has two passing options."
    },
    {
      "id": "cp3",
      "text": "Play away from pressure – look for the free player on the far side."
    },
    {
      "id": "cp4",
      "text": "Forwards: press together and close the pass into the middle."
    }
  ],
