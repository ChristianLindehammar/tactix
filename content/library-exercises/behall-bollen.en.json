  "sport": "soccer",
  "title": "Keep the ball",
  "description": "Two teams and one ball inside a box, with no goals. The team with the ball keeps it within the team as long as possible, and the other team tries to win it. If they win it, it is their turn.\n\nIf it gets messy or there are lots of children, split into two boxes and play 2v2 or 3v3. Count passes in a row out loud together. Works well for young children, from about 7 years old. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Run to a spot where the ball carrier can pass to you."
    },
    {
      "id": "cp2",
      "text": "Do not stand behind an opponent."
    },
    {
      "id": "cp3",
      "text": "Look up before you pass – who is free?"
    }
  ],
  "locale": "en",
  "difficulty": 1,
  "focus": [
    "passing",
    "positioning"
