  "sport": "soccer",
  "title": "Curve round the defender",
  "description": "Play 2 v 1 in a box of about 10 × 15 metres with a small goal at each end. A has the ball and B stands right in front of the defender X. When A starts to dribble, B makes a curved run out and round X. A plays the ball in behind to B, or dribbles past if X follows B. Finish in the far small goal.\n\nIf X wins the ball, X tries to score in the other small goal as fast as possible. Switch roles after a few goes or when the defender wins the ball. Variation: B comes towards A instead and offers a wall pass. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Dribble straight at the defender so they have to commit."
    },
    {
      "id": "cp2",
      "text": "Start the curved run when the player on the ball has turned and is driving forward – not before."
    },
    {
      "id": "cp3",
      "text": "Pass into the runner's path, ahead of B, so B can take it on without stopping."
    },
    {
      "id": "cp4",
      "text": "If the defender follows the run – take the space yourself."
    }
  ],
  "locale": "en",
  "phase": "main",
  "difficulty": 2,
