  "sport": "floorball",
  "title": "The return – one-two at pace and shot",
  "description": "One line in each corner at one end and a cone on each side further out. A runs round their cone and gets the pass from B in the other corner. A plays it straight back to B and keeps going in towards goal. B plays another first-time pass and A shoots first time from the slot. Then B runs round the cone on their side and does the same with line A.\n\nRotation: after the shot, join the other line. Variant: let A receive and fake past an imagined defender before the shot. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Full speed in the run – the passes should reach you on the move."
    },
    {
      "id": "cp2",
      "text": "Show with your stick where you want the ball."
    },
    {
      "id": "cp3",
      "text": "Every pass first time and without bounce."
    },
    {
      "id": "cp4",
      "text": "Keep going straight in towards goal after the one-two, not out to the boards."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "focus": [
    "passing",
    "shooting"
