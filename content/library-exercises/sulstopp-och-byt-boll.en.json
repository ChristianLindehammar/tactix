  "sport": "soccer",
  "title": "Sole stop and swap balls",
  "description": "Two lines side by side, everyone with a ball, and a cone in the middle of each lane. The first in each line starts on the coach's signal. Run each part for about 2 minutes with the right foot and 2 minutes with the left.\n\n1. Dribble round the cone and back, with a touch on every step.\n2. Dribble straight across to the other side with fewer touches and more pace.\n3. Dribble to the cone, stop the ball with your sole and leave it. Run diagonally across to the other lane, take the ball the other player left and dribble on.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Ball close to the foot – use the outside of the instep."
    },
    {
      "id": "cp2",
      "text": "Speed up when you take fewer touches."
    },
    {
      "id": "cp3",
      "text": "Mix short touches with slightly longer ones."
    },
    {
      "id": "cp4",
      "text": "The sole stop should leave the ball still, so your partner can take it at full speed."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "difficulty": 1,
