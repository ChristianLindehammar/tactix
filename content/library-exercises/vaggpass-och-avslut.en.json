  "sport": "floorball",
  "title": "Wall pass off the boards and finish",
  "description": "The players stand in a line at a cone, each with a ball. The first dribbles straight ahead, passes into the boards (or a bench on its side), collects the rebound on the move and shoots at goal. Fetch your ball and join the back of the line.\n\nMake it harder with a coach as a defender at the second cone. Start at a steady pace so the player ahead has time to collect their ball from the goal. Two lines can run at once. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Hit the boards at an angle so the rebound comes out in front of you."
    },
    {
      "id": "cp2",
      "text": "Keep running after the pass – meet the rebound at speed."
    },
    {
      "id": "cp3",
      "text": "Receive with a soft blade and shoot quickly."
    }
  ],
  "locale": "en",
  "difficulty": 1,
