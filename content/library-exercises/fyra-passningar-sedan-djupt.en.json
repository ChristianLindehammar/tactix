  "sport": "soccer",
  "title": "Four passes, then in behind",
  "description": "Play 4 v 4 in a middle zone of about 35 × 40 metres, with an end zone behind each team. No defenders are allowed into the end zones. A team scores by passing to a team-mate running into the opponents' end zone. Progression: the team needs at least four passes in a row before the ball in behind is allowed.\n\nVariant with big goals and keepers behind the zones: whoever receives in the zone shoots against the keeper. Add 1–2 jokers who play with the team in possession if passes are hard to find.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Check your shoulder before the ball arrives – where is the runner?"
    },
    {
      "id": "cp2",
      "text": "Start the run in behind in good time, before the player on the ball looks up."
    },
    {
      "id": "cp3",
      "text": "Run into the zone from the side of the defender, not straight behind them."
    },
    {
      "id": "cp4",
      "text": "If the way in behind is closed – keep the ball and wait for the next chance."
    }
  ],
  "locale": "en",
