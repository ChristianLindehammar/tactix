  "sport": "floorball",
  "title": "Corner duel – 1v1 by the boards",
  "description": "A duel drill in one corner of the pitch. The players are split into two lines standing a couple of metres out from the boards. Two pairs of cones mark the lines into two goal zones – one along the end boards and one along the side boards.\n\nThe coach plays a ball into the corner. That is the signal for the first player in each line to run in and play 1v1. You score by dribbling the ball into either goal zone. Change to the next pair after a goal or when the ball leaves the area.\n\nThe drawing is not to scale, and where the lines and goal zones are placed is an interpretation – adapt it to your hall.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Keep your body between the opponent and the ball – use the boards as a shield."
    },
    {
      "id": "cp2",
      "text": "Get out of the corner with speed, ideally with a turn away from the opponent."
    },
    {
      "id": "cp3",
      "text": "As the defender: block the way to the nearest goal zone and win the ball against the boards."
    },
    {
      "id": "cp4",
      "text": "Ask the players: how do you get out of the corner, and how do you protect the ball?"
    }
  ],
  "locale": "en",
  "difficulty": 1,
  "focus": [
    "ballControl",
    "defence"
  ],
  "phase": "main",
  "durationMinutes": 10,
  "minPlayers": 4,
