  "sport": "soccer",
  "title": "Play in, turn and go long",
  "description": "A counter-attack pattern without opponents. Two lines stand at each end with the middle of the pitch between them, and one player (C) stands in a box in the middle. A passes in to C, who receives and turns. At the same time B starts their run. C plays the ball long into B's path, and A runs past on their side to give the counter depth.\n\nWhen A and B arrive, the drill turns and goes the other way. Change C every few minutes, for example 3 minutes on and 1 minute rest. Variation: B plays on to A, so the ball goes to the third player.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass in to C at the right pace so C can turn straight away."
    },
    {
      "id": "cp2",
      "text": "C checks over the shoulder before the ball arrives, so the turn is quick."
    },
    {
      "id": "cp3",
      "text": "The runner goes when the pass to C is played – not later."
    },
    {
      "id": "cp4",
      "text": "The long pass should land ahead of the runner, not at their feet."
    }
  ],
  "locale": "en",
  "phase": "main",
  "difficulty": 2,
  "focus": [
    "transition",
    "passing"
  ],
  "durationMinutes": 12,
  "minPlayers": 5,
