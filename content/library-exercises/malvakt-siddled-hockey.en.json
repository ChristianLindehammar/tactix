  "sport": "hockey",
  "title": "Goalkeeper: shots from four directions",
  "description": "Four outfield players with pucks around the goal: A and B near the corners, C and D further out. A drives into the slot and shoots quickly. Then it is B's, C's and D's turn, and then it starts over. The goalkeeper has to keep working sideways.\n\nThe goalkeeper practises moving sideways and positioning to cover as much as possible from every angle. The drill also builds strength and fitness. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Goalkeeper: be set before the shot – not at the same time."
    },
    {
      "id": "cp2",
      "text": "Goalkeeper: cover the near post and come out to meet the puck."
    },
    {
      "id": "cp3",
      "text": "Outfield players: start once the goalkeeper has had time to move."
    }
  ],
  "locale": "en",
  "difficulty": 2,
