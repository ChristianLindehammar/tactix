  "sport": "soccer",
  "title": "Goalkeeper – catch the ball",
  "description": "A goalkeeper in goal and two outfield players in front of the penalty area, plus a coach to the side. A passes to B, who stands with their back to goal and lays the ball back. A shoots with the first or second touch. The goalkeeper catches the ball and rolls it to the coach. Swap roles after three shots.\n\nHarder for the goalkeeper: B chooses whether to turn and shoot or lay it back. Also vary the direction and pace of the lay-off, so the shots come from different positions and the goalkeeper cannot guess.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Keep moving with the ball – be balanced when the shot comes."
    },
    {
      "id": "cp2",
      "text": "Get your body behind the ball."
    },
    {
      "id": "cp3",
      "text": "Catch with both hands at the same time and use the whole hand to grip."
    },
    {
      "id": "cp4",
      "text": "If you can't catch it: push the ball out to the side, away from goal."
    },
    {
      "id": "cp5",
      "text": "When diving: push off with the leg nearest the ball and land with one hand behind and the other on top of the ball."
    }
  ],
  "locale": "en",
  "difficulty": 2,
