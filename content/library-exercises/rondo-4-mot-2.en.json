  "sport": "soccer",
  "title": "Rondo 4v2",
  "description": "Four players on the edges of a square, about 12 × 12 metres, keep the ball away from two players in the middle. The outside players may move along their side but not step into the square. Play with two touches at most.\n\nWhen a middle player wins the ball, or it goes out, the player who made the mistake swaps with the middle player who has been in longest. Count passes in a row – ten in a row scores a point. A pass between the two middle players counts double. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Show for the ball carrier – stand where there is a passing lane between the middle players."
    },
    {
      "id": "cp2",
      "text": "Receive on the foot furthest from the defender and open your body to the next pass."
    },
    {
      "id": "cp3",
      "text": "Look for the pass through the middle – it takes out both defenders."
    },
    {
      "id": "cp4",
      "text": "Middle players: one presses the ball carrier, the other closes the pass through the middle."
    }
  ],
  "locale": "en",
  "difficulty": 2,
  "focus": [
    "passing",
    "ballControl",
    "defence"
  ],
  "phase": "warmup",
