  "sport": "soccer",
  "title": "Pass and follow square",
  "description": "Four cones in a square, about 15 × 15 metres, with two or more players at each cone. The first player passes to the next cone, follows the pass and joins the back of that line. The receiver takes the ball in the right direction and passes on to the next cone, and so on around the square.\n\nChange direction after a while. Make it harder with one touch, with the weaker foot, or with two balls at once. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass with the inside of the foot, standing foot pointing at the receiver."
    },
    {
      "id": "cp2",
      "text": "Take your first touch in the direction of your next pass."
    },
    {
      "id": "cp3",
      "text": "Move towards the ball – do not wait for it to arrive."
    },
    {
      "id": "cp4",
      "text": "Run straight after your pass so the flow never stops."
    }
  ],
  "locale": "en",
  "difficulty": 1,
  "focus": [
    "passing",
    "ballControl"
  ],
  "phase": "warmup",
  "durationMinutes": 10,
