  "sport": "soccer",
  "title": "Give-and-go and finish",
  "description": "The players form two lines: one with balls outside the penalty area and one with wall players diagonally ahead. A cone in front of the area stands in for a defender. The first player passes to the wall, runs past the cone, gets the ball back in stride and finishes against a goalkeeper.\n\nSwap lines after each go. Vary it with one-touch finishes, the weaker foot, or a passive defender instead of the cone. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass along the ground to the wall's foot so they can return it first time."
    },
    {
      "id": "cp2",
      "text": "Start your run as the pass is played – not after."
    },
    {
      "id": "cp3",
      "text": "Wall: play the ball in front of the runner, in their running direction."
    },
    {
      "id": "cp4",
      "text": "Look up at the goalkeeper before you shoot and aim low into the corners."
    }
  ],
  "locale": "en",
  "difficulty": 2,
