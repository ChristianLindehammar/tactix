  "sport": "soccer",
  "title": "Give-and-go with the coach and shoot",
  "description": "The players stand in a line, each with a ball. The coach stands between the line and the goal. The first player passes to the coach, runs forward, gets the ball back and shoots at goal. Fetch your ball and join the back of the line.\n\nVariations: dribble a slalom or run through an agility ladder before the pass. Let the player who has just shot become goalkeeper – the old goalkeeper takes their ball and joins the line. Works well for young children, from about 7 years old. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass with the inside of your foot, straight to the coach."
    },
    {
      "id": "cp2",
      "text": "Run forward as soon as you have passed."
    },
    {
      "id": "cp3",
      "text": "Shoot first time, or take one touch forward first."
    },
    {
      "id": "cp4",
      "text": "Goalkeeper: be ready with your hands out in front."
    }
  ],
  "locale": "en",
  "difficulty": 1,
  "focus": [
    "passing",
    "shooting",
    "goalkeeping"
  ],
