  "sport": "soccer",
  "title": "1 v 1 – four goals",
  "description": "An area of about 15 × 20 metres with two small goals at each end. A line at each end, red have the balls. The first red player passes to the first blue player and steps out to defend. Blue try to get past and score in either of red's goals.\n\nIf red win the ball the roles swap straight away: red attack blue's goals and blue defend. The duel goes on until someone scores or the ball goes out. Join the back of the other line afterwards. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Keep the ball close as you get near the defender."
    },
    {
      "id": "cp2",
      "text": "Watch the ball while you dribble and look up once you are past."
    },
    {
      "id": "cp3",
      "text": "Shield the ball with your body – dribble with the foot furthest from the opponent."
    },
    {
      "id": "cp4",
      "text": "If you lose the ball – defend straight away."
    }
  ],
