  "sport": "floorball",
  "title": "Half moon – goalkeeper warm-up",
  "description": "The players stand in a half circle in front of one goal, each with a ball. They shoot in turn from one end of the arc to the other, so the goalkeeper has to move and face shots from different angles.\n\nStart with gentle shots and build up. Change direction, shoot from alternate sides, or call a number for who shoots next. Mix low and high shots. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Wait until the goalkeeper is set before you shoot."
    },
    {
      "id": "cp2",
      "text": "Gentle shots first – the goalkeeper should get warm, not hurt."
    },
    {
      "id": "cp3",
      "text": "Goalkeeper: follow the ball and shuffle sideways between shots."
    }
  ],
