  "sport": "soccer",
  "title": "Diagonal passes and shoot",
  "description": "Three cones zigzagging up towards a goal, one player at each cone and the rest in a line at the first. The first player passes diagonally to cone 2, who passes diagonally on to cone 3. The player at cone 3 receives and shoots at goal.\n\nAfter your pass, run to the next cone. The shooter fetches the ball and joins the line at the first cone. Let the children take turns in goal. Works well for young children, from about 7 years old. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass with the inside of your foot and aim at your team-mate's feet."
    },
    {
      "id": "cp2",
      "text": "Receive so the ball ends up in front of you, in the direction you will play."
    },
    {
      "id": "cp3",
      "text": "Run to the next cone straight after your pass."
    }
  ],
  "locale": "en",
  "difficulty": 1,
