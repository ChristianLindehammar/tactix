  "sport": "soccer",
  "title": "Turn at the middle cone",
  "description": "A square of about 15 × 15 metres with a cone in each corner and one in the middle. Two players at each corner and one ball per corner. The first player dribbles in towards the middle cone, turns 180 degrees, dribbles back and hands the ball to the next player.\n\nAll four go at the same time, so it gets busy in the middle – look up! Turn both ways and try different turns: inside, outside or with the sole. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Look up just before you turn, and at the ball as you turn."
    },
    {
      "id": "cp2",
      "text": "Bend at the hips and knees and use your arms for balance."
    },
    {
      "id": "cp3",
      "text": "Speed up straight out of the turn."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "difficulty": 1,
