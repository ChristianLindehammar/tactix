  "sport": "soccer",
  "title": "1v1 to goal",
  "description": "A defender stands by the goal and an attacker about 25 metres out, between two cones. The defender plays the ball to the attacker and steps out straight away to stop them. The attacker tries to get past and finish; the defender steers the attacker away or wins the ball. Use a goalkeeper if you have one.\n\nIf the defender wins the ball, they can score by dribbling it over the cone line. Use two lines and swap roles after each go. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Attack: take your first touch forward and run at the defender."
    },
    {
      "id": "cp2",
      "text": "Attack: make your move when the defender is close – not too early."
    },
    {
      "id": "cp3",
      "text": "Defence: get out quickly, slow down for the last few metres and stand side-on on your toes."
    },
    {
      "id": "cp4",
      "text": "Defence: steer the attacker to the side and away from goal."
    }
  ],
