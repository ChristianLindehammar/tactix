  "sport": "floorball",
  "title": "Goalkeeper: moving sideways",
  "description": "Two outfield players stand just outside the goal crease and pass the ball between them at least three times before one of them shoots. The goalkeeper follows every pass and should always be set when the shot comes.\n\nThe goalkeeper practises moving quickly and smoothly, and keeping their balance while moving. Have the players vary when the shot comes so the goalkeeper cannot predict it. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Goalkeeper: small, quick steps – do not cross your legs."
    },
    {
      "id": "cp2",
      "text": "Keep the upper body still and your eyes on the ball."
    },
    {
      "id": "cp3",
      "text": "Outfield players: only shoot once the goalkeeper has had a chance to get set."
    }
  ],
  "locale": "en",
  "difficulty": 1,
  "focus": [
    "goalkeeping"
  ],
  "phase": "warmup",
