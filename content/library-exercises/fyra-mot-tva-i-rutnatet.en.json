  "sport": "soccer",
  "title": "4 v 2 in the grid",
  "description": "An area of about 12 × 9 metres is split with cones into nine small boxes. Four players keep the ball from two. Only one attacker may stand in each box, and once you have passed you must move to a new, free box. The defenders move freely.\n\nChange defenders after a turnover or after a set time. Start with free touches, then limit to two or one. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Keep checking – which boxes are free?"
    },
    {
      "id": "cp2",
      "text": "Stand so no defender is between you and the ball."
    },
    {
      "id": "cp3",
      "text": "Two team-mates close to the ball and one further away give the player on the ball several options."
    },
    {
      "id": "cp4",
      "text": "Pass and move at once – never stand still after your pass."
    }
  ],
