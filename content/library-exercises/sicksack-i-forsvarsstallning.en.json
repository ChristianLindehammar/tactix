  "sport": "basketball",
  "title": "Zig-zag in defensive stance",
  "description": "Set out cones in a zig-zag in two lanes, one on each side, from the baseline up towards half-court. Each lane is as wide as the gap between the sideline and the lane. Players form two lines on the baseline. The first player in each line drops into a defensive stance and slides diagonally to the first cone. At the cone the player opens the hip (drop step) and slides on to the next cone, all the way to half-court. The next player goes when the one ahead reaches the second cone. Jog back along the sideline.\n\nProgression: work in pairs. The attacker dribbles the zig-zag at half speed and the defender mirrors without going for the ball – the focus is footwork. Switch roles after every lane. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Low and wide – never cross or click your feet together."
    },
    {
      "id": "cp2",
      "text": "Turn with a short, quick drop step, hip first, without standing up."
    },
    {
      "id": "cp3",
      "text": "Active hands and keep your head at the same height all the way."
    },
    {
      "id": "cp4",
      "text": "With an attacker: stay an arm's length in front and read the hips, not the ball."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "difficulty": 1,
  "focus": [
    "defence",
    "conditioning"
  ],
