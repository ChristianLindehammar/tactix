  "sport": "soccer",
  "title": "Ajax triangle",
  "description": "Three players in a triangle, with a row of cones along one side. Player 1 passes to player 2, who receives and passes on to player 3. Player 3 then dribbles the ball through the cones back to the starting spot.\n\nFollow your pass so everyone gets to try every spot. With lots of children, set up two or three triangles side by side. Works well for young children, from about 7 years old. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass with the inside of your foot and look at the player you are passing to."
    },
    {
      "id": "cp2",
      "text": "Receive and turn towards the next player with the same touch."
    },
    {
      "id": "cp3",
      "text": "Small touches between the cones, with both feet."
    }
  ],
  "locale": "en",
  "difficulty": 1,
