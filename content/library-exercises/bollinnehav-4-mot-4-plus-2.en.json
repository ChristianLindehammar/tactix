  "sport": "soccer",
  "title": "Possession 4v4 + 2 jokers",
  "description": "Two teams of four play inside a box of about 25 × 25 metres. Two jokers stand on opposite sides outside the box and always play with the team that has the ball, making it 6v4. The team in possession scores a point for six passes in a row. Jokers have two touches and may not pass to each other.\n\nIf the other team wins the ball it is their turn straight away – and the jokers switch sides in their heads. Change jokers after a few minutes. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Create width and depth – never two players on the same line."
    },
    {
      "id": "cp2",
      "text": "Use a joker to escape pressure, then look for a player on the far side."
    },
    {
      "id": "cp3",
      "text": "When you lose the ball: press straight away, the first seconds decide it."
    },
    {
      "id": "cp4",
      "text": "When you win the ball: play the first pass away from pressure, ideally to a joker."
    }
  ],
  "locale": "en",
  "difficulty": 3,
  "focus": [
    "passing",
    "positioning",
    "transition"
  ],
  "phase": "main",
  "durationMinutes": 15,
