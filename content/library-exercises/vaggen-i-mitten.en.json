  "sport": "soccer",
  "title": "The wall in the middle",
  "description": "Two lines face each other, about 20–30 metres apart, and one player (C) stands in the middle, a little to the side. The first in the line dribbles out, plays a one-two with C and then passes on to the other line. Follow the ball and join the back of that line. Then the drill goes the other way. C stays where they are.\n\nChange the middle player after a while. Variant: two middle players, one on each side, so the ball can go via both. For ages 9–11.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Pass with the inside of the foot – it gives the best accuracy."
    },
    {
      "id": "cp2",
      "text": "Play the return pass in front of the runner, so they can take it in their stride."
    },
    {
      "id": "cp3",
      "text": "If the middle player has their back to you – get free diagonally in front of them."
    },
    {
      "id": "cp4",
      "text": "Control with your first touch and pass with your second."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "difficulty": 1,
  "focus": [
    "passing",
    "ballControl",
    "positioning"
  ],
  "durationMinutes": 15,
  "minPlayers": 5,
