  "sport": "floorball",
  "title": "Ajax game – 4v2 with goals",
  "description": "Four attackers keep the ball away from two defenders in an area of about 20 × 10 metres with a goal at each end (not to scale). The attackers score a point every time all four have touched the ball without losing it. The defenders chase the ball, and if they win it they attack straight away on either goal – so the drill trains both passing and transition.\n\nUse goalkeepers if you have them; small goals work fine otherwise. Play until someone reaches five points, then change defenders. Make the area bigger for younger or less experienced players.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Keep moving so the ball carrier always has two passing options."
    },
    {
      "id": "cp2",
      "text": "Play the ball away from the pressure – often to whoever is furthest from the defenders."
    },
    {
      "id": "cp3",
      "text": "Defenders: work together, one presses and one closes the passing lane."
    },
    {
      "id": "cp4",
      "text": "When you win the ball: look up straight away and go for the more open goal."
    },
    {
      "id": "cp5",
      "text": "Ask the players: what is the easiest way to keep the ball, and what do you do the moment you lose it?"
    }
  ],
  "locale": "en",
  "difficulty": 2,
  "focus": [
    "passing",
    "positioning",
    "transition"
  ],
  "phase": "main",
  "durationMinutes": 15,
  "minPlayers": 6,
  "maxPlayers": 12,
