  "sport": "hockey",
  "title": "Simple handover – shot and rebound",
  "description": "Two lines at the centre line, one by each board. A passes along the centre line to B, who skates with the puck diagonally in towards the middle. A skates in at the same time, and B hands the puck over to A, who shoots. B skates on towards goal and picks up any rebound.\n\nSwap lines after each turn, or play the first pass from alternate sides. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Leave the puck dead still at the handover – A takes it at speed."
    },
    {
      "id": "cp2",
      "text": "The receiver should arrive at full speed, not stand and wait."
    },
    {
      "id": "cp3",
      "text": "B: always follow in towards goal – rebounds bring lots of goals."
    }
  ],
  "locale": "en",
  "difficulty": 1,
