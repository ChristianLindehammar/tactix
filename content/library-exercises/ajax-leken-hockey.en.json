  "sport": "hockey",
  "title": "Ajax game – 4v2 with nets",
  "description": "Four attackers keep the puck away from two defenders inside a marked area with a small net at each end – for example one zone, or part of it (not to scale). The attackers score a point every time all four have touched the puck without losing it. The defenders chase the puck, and if they win it they attack straight away on either net – so the drill trains both passing and transition.\n\nUse goalies if you have them; small nets work fine otherwise. Play until someone reaches five points, then change defenders. Make the area bigger for younger or less experienced players.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Keep moving so the puck carrier always has two passing options."
    },
    {
      "id": "cp2",
      "text": "Move the puck away from pressure – often to whoever is furthest from the defenders."
    },
    {
      "id": "cp3",
      "text": "Defenders: work together, one pressures and one takes away the passing lane with the stick."
    },
    {
      "id": "cp4",
      "text": "When you win the puck: look up straight away and go for the more open net."
    },
    {
      "id": "cp5",
      "text": "Ask the players: what is the easiest way to keep the puck, and what do you do the moment you lose it?"
    }
  ],
  "locale": "en",
  "difficulty": 2,
  "focus": [
    "passing",
    "positioning",
    "transition"
  ],
  "phase": "main",
  "durationMinutes": 15,
  "minPlayers": 6,
  "maxPlayers": 12,
