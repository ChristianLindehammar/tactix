  "sport": "floorball",
  "title": "Popcorn – clear your half",
  "description": "Split the court in the middle with benches (or cones), with one team in each half. Put about ten loose balls on each side. On the signal everyone shoots balls over to the other half as fast as they can. Stop after a while – the team with the fewest balls on its side wins.\n\nKeep the players spread out so no one is hit by a ball or a stick. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Look up before you shoot – is there space around you?"
    },
    {
      "id": "cp2",
      "text": "Control the ball first, then shoot."
    },
    {
      "id": "cp3",
      "text": "No high sticks."
    }
  ],
