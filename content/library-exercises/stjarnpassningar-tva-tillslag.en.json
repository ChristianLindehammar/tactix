  "sport": "soccer",
  "title": "Star passing on two touches",
  "description": "Six players stand in a pentagon with about 10 metres between each spot, two of them at the start. The ball goes round in a star: every pass skips the nearest neighbour and goes to the spot across. The receiver controls and passes on with the second touch. Follow your pass and take the receiver's place.\n\nChange direction after a couple of minutes. Progression: shorten the distances so the passer can run in and press the receiver – the first touch must then take the ball away from the pressure. For ages 9–11.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Stand with knees slightly bent and arms a little out for balance."
    },
    {
      "id": "cp2",
      "text": "Meet the ball with your foot and give with it to cushion it."
    },
    {
      "id": "cp3",
      "text": "Toes up, heel down – a firm foot makes the touch easy."
    },
    {
      "id": "cp4",
      "text": "Look up and move the ball the way you are going to pass."
    }
  ],
  "locale": "en",
  "phase": "warmup",
  "difficulty": 2,
