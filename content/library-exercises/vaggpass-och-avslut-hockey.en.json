  "sport": "hockey",
  "title": "Wall pass off the boards and shoot",
  "description": "The players stand in a line at a cone, each with a puck. The first skates straight ahead with the puck, passes it into the boards, picks up the rebound at speed and shoots at the net. Fetch your puck and join the back of the line.\n\nMake it harder with a coach as a defender at the second cone. Start at a steady pace so the player ahead has time to collect their puck. Two lines can run at once, one along each board. The diagram is not to scale.",
  "coachingPoints": [
    {
      "id": "cp1",
      "text": "Hit the boards at an angle so the rebound comes out in front of you."
    },
    {
      "id": "cp2",
      "text": "Keep skating after the pass – meet the rebound at speed."
    },
    {
      "id": "cp3",
      "text": "Receive with a soft blade and shoot quickly."
    }
  ],
