DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Optional. Defaults to this folder.
LOG_DIRECTORY=
# Sends sign-in codes. Port 465 uses SSL, and other ports use STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Gets an email when an exercise is first reported. Without it, check with scripts/moderate.py.
MODERATOR_EMAIL=
# Protects stored sign-in codes. Make one with: openssl rand -hex 32. Without it, email sign-in is off.
SIGN_IN_CODE_KEY=
# Comma-separated. Google: the iOS, Android and web client IDs.
GOOGLE_CLIENT_IDS=
# Comma-separated. Apple: the app's bundle ID and the Services ID for Android and web.
APPLE_CLIENT_IDS=
# Optional, but the App Store requires it: lets deleting an account remove CoachMate from the coach's Apple ID.
# A Sign in with Apple key from developer.apple.com (Keys), its key ID, and the team ID.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 file. Keep it outside the public web folder, readable only by the app.
APPLE_PRIVATE_KEY_PATH=
# Encrypts Apple's stored tokens. Make one with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored tokens unusable, so only accounts that sign in with Apple again can be revoked.
APPLE_TOKEN_KEY=
# The secret API key, for asking RevenueCat who has a plan. Never put it in the app.
REVENUECAT_SECRET_KEY=
# The entitlement that unlocks exercises, as named in RevenueCat.
REVENUECAT_ENTITLEMENT=premium
# The webhook's authorization header value, as set in RevenueCat.
REVENUECAT_WEBHOOK_SECRET=
# Optional. The invite page links coaches without the app here. The App Store link's id also turns on Safari's app banner.
APP_STORE_URL=
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.lindehammarkonsult.coachmate
