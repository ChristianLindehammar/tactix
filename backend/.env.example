DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# Optional. Defaults to this folder.
LOG_DIRECTORY=
# Sends sign-in codes. Port 465 uses SSL, and other ports use STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Protects stored sign-in codes. Make one with: openssl rand -hex 32. Without it, email sign-in is off.
SIGN_IN_CODE_KEY=
# Comma-separated. Google: the iOS, Android and web client IDs.
GOOGLE_CLIENT_IDS=
# Comma-separated. Apple: the app's bundle ID and the Services ID for Android and web.
APPLE_CLIENT_IDS=
# The secret API key, for asking RevenueCat who has a plan. Never put it in the app.
REVENUECAT_SECRET_KEY=
# The entitlement that unlocks exercises, as named in RevenueCat.
REVENUECAT_ENTITLEMENT=premium
# The webhook's authorization header value, as set in RevenueCat.
REVENUECAT_WEBHOOK_SECRET=
