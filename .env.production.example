# Settings baked into release builds (fastlane, App Store, Google Play).
# Copy this file to .env.production.local, which git ignores, and fill it in.
# Values here are public: they end up inside the app, so never put a secret here.

# RevenueCat public SDK keys, from RevenueCat > Project settings > API keys.
# The App Store key starts with appl_, the Play Store key with goog_.
# Without them a release build says purchases aren't available. Test keys (test_) are refused.
# The secret key (sk_) belongs on the server only, see backend/.env.example.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
